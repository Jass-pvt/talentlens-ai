# Copy to .env (which is git-ignored). Every value is optional.

# Raises the GitHub API limit from 60 to 5000 requests/hour. Read-only public scope is enough.
GITHUB_TOKEN=
GITHUB_TIMEOUT=8

# Optional semantic layer. Leave LLM_PROVIDER empty to run fully deterministic.
# Supported providers: anthropic
LLM_TIMEOUT=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
